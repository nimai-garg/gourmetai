# Copy to .env locally. Use the existing Firebase web app configuration.
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=gourmetai-c3818
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
# Server only. Never prefix this key with REACT_APP_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional server-side Firebase web API key override for token verification.
FIREBASE_API_KEY=
# Public browser key for USDA food search. DEMO_KEY has a limited quota.
REACT_APP_USDA_API_KEY=DEMO_KEY
