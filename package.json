{
  "name": "gourmetai",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fontsource/geist-mono": "^5.0.3",
    "@fontsource/geist-sans": "^5.0.3",
    "axios": "^1.7.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase": "^12.19.0",
    "lucide-react": "^0.428.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^5.3.0",
    "react-router-dom": "^7.18.4",
    "styled-components": "^6.1.11"
  },
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "jest",
    "start:api": "node server.js",
    "test:api": "node --test tests/*.test.cjs",
    "check": "npm test -- --runInBand && npm run test:api && npm run build"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^6.0.0",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "vite": "^8.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.[jt]s?(x)"
    ],
    "moduleNameMapper": {
      "^axios$": "<rootDir>/node_modules/axios/dist/node/axios.cjs",
      "^@fontsource/.*$": "<rootDir>/tests/styleMock.cjs",
      "\\.css$": "<rootDir>/tests/styleMock.cjs",
      "\\.(otf|png|jpg|svg)$": "<rootDir>/tests/assetMock.cjs"
    },
    "clearMocks": true,
    "resetMocks": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
